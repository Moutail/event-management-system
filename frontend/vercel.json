{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "https://event-management-backend.onrender.com/media/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://event-management-backend.onrender.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "https://event-management-backend.onrender.com/api",
    "REACT_APP_BASE_URL": "https://event-management-backend.onrender.com",
    "REACT_APP_STRIPE_PK": "@stripe_public_key",
    "REACT_APP_GOOGLE_CLIENT_ID": "@google_client_id",
    "REACT_APP_FACEBOOK_APP_ID": "@facebook_app_id"
  }
}
