{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm ci",
  "framework": "create-react-app",
  "env": {
    "REACT_APP_API_URL": "https://event-management-backend-7uux.onrender.com/api",
    "REACT_APP_BASE_URL": "https://event-management-backend-7uux.onrender.com",
    "REACT_APP_STRIPE_PK": "pk_test_51RxzOq2NgztfBRhsPKZ5VAUd2GIGiBN220HOaG2Egpie9JSLGo5aK4nYG29g9ejU30CCGziRyNUJos71iCnmQfHv00L5znX6H1",
    "REACT_APP_SOCIAL_AUTH_ENABLED": "true",
    "REACT_APP_SOCIAL_AUTH_SUCCESS_URL": "/dashboard",
    "REACT_APP_SOCIAL_AUTH_FAILURE_URL": "/login?error=social_auth_failed",
    "REACT_APP_DEBUG_MODE": "false"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://event-management-backend-7uux.onrender.com/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://event-management-backend-7uux.onrender.com/media/$1"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}